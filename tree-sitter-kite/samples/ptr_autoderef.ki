type Node:
    v: int
    next: ptr<Node>

make push(head: ptr<Node>, v: int) -> ptr<Node>:
    n = alloc(Node)
    n.v = v
    n.next = head
    return n

make sum(p: ptr<Node>) -> int:
    t = 0
    while p != null:
        t += p.v
        p = p.next
    return t

make main():
    h: ptr<Node> = null
    h = push(h, 1)
    h = push(h, 2)
    h = push(h, 39)
    print(sum(h))
    print(h.next.next.v)
