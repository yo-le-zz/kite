class Counter:
    n: int
    make init(self, start: int = 0):
        self.n = start
    make inc(self, by: int = 1):
        self.n = self.n + by
    make get(self) -> int:
        return self.n

make main():
    c = Counter(5)
    c.inc()
    c.inc(by=10)
    print(c.get())
    d = Counter()
    print(f"d={d.get()}")
