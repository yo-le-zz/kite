enum Tree:
    Leaf(v: int)
    Nil

make depth(t: Tree) -> int:
    match t:
        case Leaf(v):
            return v
        else:
            return -1

make main():
    for i = 0 to 3:
        print(i)
    print(depth(Tree.Leaf(7)))
    print(depth(Tree.Nil))
    m = StrMap_string()
    m.set("a", "x")
    m.set("b", "y")
    for k in m.keys:
        print(k + "=" + m.get(k))
