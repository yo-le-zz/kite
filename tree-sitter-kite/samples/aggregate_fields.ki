type Inner:
    a: int
type Bag:
    items: [int]
    inner: Inner
    names: [string]

make fill(b: Bag):
    append(b.items, 7)
    append(b.names, "x")

make main():
    b = Bag()
    append(b.items, 1)
    append(b.items, 2)
    fill(b)
    b.inner.a = 42
    print(len(b.items))
    print(b.items[2])
    print(b.inner.a)
    print(b.names[0])
    for v in b.items:
        print(v)
