type Tok:
    kind: int
    text: string

make mk(k: int, t: string) -> Tok:
    x = Tok()
    x.kind = k
    x.text = t
    return x

make main():
    xs = [mk(1, "a"), mk(2, "b")]
    append(xs, mk(3, "c"))
    print(len(xs))
    print(xs[1].text)
    for t in xs:
        print(f"{t.kind}:{t.text}")
