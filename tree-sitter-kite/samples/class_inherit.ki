class Animal:
    name: string
    make init(self, name: string):
        self.name = name
    make describe(self) -> string:
        return f"I am {self.name}"

class Dog(Animal):
    tricks: int
    make init(self, name: string, tricks: int):
        Animal.init(self, name)
        self.tricks = tricks
    make bark(self) -> string:
        return f"{self.name} barks, knows {self.tricks} tricks"

make show(a: Animal):
    print(a.describe())

make main():
    d = Dog("Rex", 3)
    print(d.describe())
    print(d.bark())
    show(d)
