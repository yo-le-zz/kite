// Readiness test for bootstrapping: lexer + recursive-descent parser +
// AST (data enum with pointers) + evaluator with a symbol table.

enum Expr:
    Num(v: int)
    Var(name: string)
    Bin(op: string, l: ptr<Expr>, r: ptr<Expr>)

type Tok:
    kind: string
    text: string

class Parser:
    toks: [Tok]
    pos: int

    make peek(self) -> Tok:
        if self.pos < len(self.toks):
            return self.toks[self.pos]
        t = Tok()
        t.kind = "eof"
        return t

    make next(self) -> Tok:
        t = self.peek()
        self.pos += 1
        return t

    make atom(self) -> ptr<Expr>:
        t = self.next()
        p = alloc(Expr)
        if t.kind == "int":
            *p = Expr.Num(to_int(t.text))
        orif t.kind == "ident":
            *p = Expr.Var(t.text)
        orif t.text == "(":
            inner = self.expr()
            self.next()
            return inner
        return p

    make term(self) -> ptr<Expr>:
        left = self.atom()
        while self.peek().text == "*" or self.peek().text == "/":
            op = self.next().text
            right = self.atom()
            n = alloc(Expr)
            *n = Expr.Bin(op, left, right)
            left = n
        return left

    make expr(self) -> ptr<Expr>:
        left = self.term()
        while self.peek().text == "+" or self.peek().text == "-":
            op = self.next().text
            right = self.term()
            n = alloc(Expr)
            *n = Expr.Bin(op, left, right)
            left = n
        return left

make tokenize(src: string) -> [Tok]:
    out: [Tok] = []
    i = 0
    while i < len(src):
        c = char_at(src, i)
        if is_space(c):
            i += 1
        orif is_digit(c):
            s = i
            while i < len(src) and is_digit(char_at(src, i)):
                i += 1
            t = Tok()
            t.kind = "int"
            t.text = substr(src, s, i)
            append(out, t)
        orif is_alpha(c):
            s = i
            while i < len(src) and is_alnum(char_at(src, i)):
                i += 1
            t = Tok()
            t.kind = "ident"
            t.text = substr(src, s, i)
            append(out, t)
        else:
            t = Tok()
            t.kind = "op"
            t.text = substr(src, i, i + 1)
            append(out, t)
            i += 1
    return out

make eval(e: ptr<Expr>, env: StrMap_int) -> int:
    x = *e
    match x:
        case Num(v):
            return v
        case Var(name):
            return env.get(name)
        case Bin(op, l, r):
            a = eval(l, env)
            b = eval(r, env)
            if op == "+":
                return a + b
            orif op == "-":
                return a - b
            orif op == "*":
                return a * b
            return a / b
    return 0

make main():
    env = StrMap_int()
    env.set("x", 5)
    env.set("y", 7)
    p = Parser()
    p.toks = tokenize("(x + 3) * y - 10 / 2")
    tree = p.expr()
    print(eval(tree, env))
