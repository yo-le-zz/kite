make pair(a: int, b: int) -> (int, int):
    return (a + b, a * b)

make sum_list(xs: [int]) -> int:
    t = 0
    for x in xs:
        t += x
    return t

make fill(xs: [int], n: int):
    i = 0
    while i < n:
        append(xs, i * i)
        i += 1

make squares(n: int) -> [int]:
    r = [0]
    i = 1
    while i < n:
        append(r, i * i)
        i += 1
    return r

make main():
    s, p = pair(3, 4)
    print(f"sum={s} prod={p}")
    l = [1, 2, 3]
    print(sum_list(l))
    fill(l, 4)
    print(f"len after fill = {len(l)}")
    q = squares(6)
    print(sum_list(q))
    print(sum_list(squares(4)))
    print(pair(5, 6)[1])
