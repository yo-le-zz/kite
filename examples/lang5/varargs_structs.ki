type Point:
    x: int
    y: int

make total(*xs: int) -> int:
    t = 0
    for x in xs:
        t += x
    return t

make shift(p: Point, dx: int):
    p.x = p.x + dx

make origin() -> Point:
    p = Point()
    p.x = 1
    p.y = 2
    return p

make main():
    print(total(1, 2, 3))
    print(total())
    o = origin()
    shift(o, 10)
    print(f"{o.x},{o.y}")
