make main():
    parts = split("a,bb,,ccc", ",")
    print(len(parts))
    print(join(parts, "|"))
    print(trim("  hi  ") + "!")
    print(find("hello world", "o w"))
    print(starts_with("kite", "ki"))
    print(replace_all("a-b-c", "-", "+"))
    print(to_int(" -42"))
    print(chr(65) + chr(97) + chr(10) + "x")
    m = StrMap_int()
    m.set("one", 1)
    m.set("two", 2)
    m.set("one", 11)
    i = 0
    while i < 100:
        m.set(f"k{i}", i)
        i += 1
    print(m.get("one"))
    print(m.get("two"))
    print(m.get("k77"))
    print(m.get("zzz"))
    print(m.has("k5"))
    print(m.size())
