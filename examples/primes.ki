// A simple (trial-division) prime sieve up to a limit, using a growable
// list and the `or`/`and` boolean operators.
make is_prime(n: int) -> bool:
    if n < 2:
        return false
    i = 2
    until i * i > n:
        if n % i == 0:
            return false
        i = i + 1
    return true

make main():
    primes = [2]
    n = 3
    until n > 50:
        if is_prime(n):
            append(primes, n)
        n = n + 2

    for p in primes:
        print(p)
