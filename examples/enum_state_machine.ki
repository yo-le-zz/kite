// A traffic light modeled as an enum-driven state machine.
enum Light:
    Red
    Yellow
    Green

make next(current: Light) -> Light:
    if current == Light.Red:
        return Light.Green
    orif current == Light.Green:
        return Light.Yellow
    return Light.Red

make name(l: Light) -> string:
    if l == Light.Red:
        return "red"
    orif l == Light.Yellow:
        return "yellow"
    return "green"

make main():
    light = Light.Red
    for i = 1 to 6:
        print(name(light))
        light = next(light)
