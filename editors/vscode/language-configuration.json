{
  "comments": { "lineComment": "//" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:extern\\s+)?(?:async\\s+)?make|class|type|enum|if|orif|else|until|while|infinit|for|try|failed|finally|thread|match|case)\\b.*:\\s*(?:\\/\\/.*)?$",
    "decreaseIndentPattern": "^\\s*(?:orif|else|failed|finally|case)\\b.*:\\s*(?:\\/\\/.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:extern\\s+)?(?:async\\s+)?make|class|type|enum|if|orif|else|until|while|infinit|for|try|failed|finally|thread|match|case)\\b.*:\\s*(?:\\/\\/.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:return|break|continue)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ],
  "folding": { "offSide": true, "markers": { "start": "^\\s*//\\s*#?region\\b", "end": "^\\s*//\\s*#?endregion\\b" } },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d+(?:\\.\\d+)?",
  "colorizedBracketPairs": [["(", ")"], ["[", "]"], ["{", "}"]]
}
