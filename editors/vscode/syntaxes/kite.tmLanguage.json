{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kite",
  "scopeName": "source.kite",
  "fileTypes": [
    "ki"
  ],
  "patterns": [
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "statement": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#import"
        },
        {
          "include": "#class-def"
        },
        {
          "include": "#struct-def"
        },
        {
          "include": "#enum-def"
        },
        {
          "include": "#function-def"
        },
        {
          "include": "#case-clause"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#fstring"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#self"
        },
        {
          "include": "#alloc"
        },
        {
          "include": "#method-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#member-access"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#enum-member"
        },
        {
          "include": "#constructor-or-type"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "comment": {
      "name": "comment.line.double-slash.kite",
      "match": "//.*$",
      "captures": {
        "0": {
          "name": "punctuation.definition.comment.kite"
        }
      }
    },
    "import": {
      "patterns": [
        {
          "match": "^\\s*(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.kite"
            },
            "2": {
              "name": "entity.name.namespace.kite"
            }
          }
        },
        {
          "match": "^\\s*(from)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+(import)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.import.kite"
            },
            "2": {
              "name": "entity.name.namespace.kite"
            },
            "3": {
              "name": "keyword.control.import.kite"
            },
            "4": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_]*",
                  "name": "entity.name.function.imported.kite"
                },
                {
                  "include": "#punctuation"
                }
              ]
            }
          }
        }
      ]
    },
    "class-def": {
      "begin": "^(\\s*)(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\)))?\\s*(:)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.class.kite"
        },
        "3": {
          "name": "entity.name.type.class.kite"
        },
        "4": {
          "name": "punctuation.definition.inheritance.begin.kite"
        },
        "5": {
          "name": "entity.other.inherited-class.kite"
        },
        "6": {
          "name": "punctuation.definition.inheritance.end.kite"
        },
        "7": {
          "name": "punctuation.separator.colon.kite"
        }
      },
      "end": "^(?!\\1\\s+\\S|\\s*$)",
      "name": "meta.class.kite",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#field-decl"
        },
        {
          "include": "#statement"
        }
      ]
    },
    "struct-def": {
      "begin": "^(\\s*)(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.struct.kite"
        },
        "3": {
          "name": "entity.name.type.struct.kite"
        },
        "4": {
          "name": "punctuation.separator.colon.kite"
        }
      },
      "end": "^(?!\\1\\s+\\S|\\s*$)",
      "name": "meta.struct.kite",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#field-decl"
        }
      ]
    },
    "enum-def": {
      "begin": "^(\\s*)(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.enum.kite"
        },
        "3": {
          "name": "entity.name.type.enum.kite"
        },
        "4": {
          "name": "punctuation.separator.colon.kite"
        }
      },
      "end": "^(?!\\1\\s+\\S|\\s*$)",
      "name": "meta.enum.kite",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.enummember.kite"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "name": "variable.other.property.kite"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constructor-or-type"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "field-decl": {
      "match": "^\\s+(?!(?:make|extern|async)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*\\S)",
      "captures": {
        "1": {
          "name": "variable.other.property.kite"
        },
        "2": {
          "name": "punctuation.separator.colon.kite"
        }
      },
      "name": "meta.field.kite"
    },
    "function-def": {
      "begin": "\\b(?:(extern)\\s+)?(?:(async)\\s+)?(make)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.extern.kite"
        },
        "2": {
          "name": "storage.modifier.async.kite"
        },
        "3": {
          "name": "storage.type.function.kite"
        },
        "4": {
          "name": "entity.name.function.kite"
        },
        "5": {
          "name": "punctuation.definition.parameters.begin.kite"
        }
      },
      "end": "(\\))(?:\\s*(->)\\s*)?",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.end.kite"
        },
        "2": {
          "name": "keyword.operator.arrow.kite"
        }
      },
      "name": "meta.function.kite",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "\\*(?=\\s*[A-Za-z_])",
          "name": "keyword.operator.variadic.kite"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.self.kite"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constructor-or-type"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?::|=|,|\\)))",
          "name": "variable.parameter.kite"
        },
        {
          "include": "#fstring"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "case-clause": {
      "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\()([^)]*)(\\)))?",
      "name": "meta.case.kite",
      "captures": {
        "1": {
          "name": "keyword.control.case.kite"
        },
        "2": {
          "name": "variable.other.enummember.kite"
        },
        "4": {
          "name": "variable.parameter.binding.kite"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|orif|else|until|while|infinit|for|to|in|return|break|continue|try|failed|finally|thread|match|case|await)\\b",
          "name": "keyword.control.kite"
        },
        {
          "match": "\\b(make)\\b",
          "name": "storage.type.function.kite"
        },
        {
          "match": "\\b(extern|async)\\b",
          "name": "storage.modifier.kite"
        },
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.logical.kite"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.kite"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.kite"
        }
      ]
    },
    "self": {
      "match": "\\bself\\b",
      "name": "variable.language.self.kite"
    },
    "number": {
      "patterns": [
        {
          "match": "\\b[0-9]+\\.[0-9]+\\b",
          "name": "constant.numeric.float.decimal.kite"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.decimal.kite"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.kite",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kite"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kite"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        }
      ]
    },
    "string-escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.kite"
    },
    "fstring": {
      "begin": "\\bf(\")",
      "end": "\"|$",
      "name": "string.quoted.double.format.kite",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.kite"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kite"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        },
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.brace.kite"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.interpolation.kite",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.kite"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.kite"
        }
      },
      "contentName": "meta.embedded.expression.kite",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "alloc": {
      "match": "\\b(alloc|alloc_n)(?=\\s*\\()",
      "name": "support.function.builtin.kite"
    },
    "method-call": {
      "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.kite"
        },
        "2": {
          "name": "entity.name.function.method.kite"
        }
      }
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b(print|len|str|append|pop|remove|insert|clear|exit|char_at|substr|read_file|write_file|arg|arg_count|free|split|join|find|trim|starts_with|ends_with|replace_all|repeat|chr|to_int|min|max|abs)(?=\\s*\\()",
          "name": "support.function.builtin.kite"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.type.constructor.kite"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.function.call.kite"
        }
      ]
    },
    "member-access": {
      "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.kite"
        },
        "2": {
          "name": "variable.other.property.kite"
        }
      }
    },
    "types": {
      "patterns": [
        {
          "begin": "\\b(ptr)\\s*(<)",
          "end": "(>)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.pointer.kite"
            },
            "2": {
              "name": "punctuation.definition.generic.begin.kite"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.generic.end.kite"
            }
          },
          "name": "meta.type.pointer.kite",
          "patterns": [
            {
              "include": "#types"
            },
            {
              "include": "#constructor-or-type"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "match": "\\b(int|float|bool|string)\\b",
          "name": "support.type.primitive.kite"
        },
        {
          "match": "\\b(ptr)\\b",
          "name": "storage.type.pointer.kite"
        }
      ]
    },
    "enum-member": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\.\\s*[A-Z])",
      "name": "entity.name.type.enum.kite"
    },
    "constructor-or-type": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.kite"
    },
    "variable": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.readwrite.kite"
    },
    "operators": {
      "patterns": [
        {
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=",
          "name": "keyword.operator.assignment.compound.kite"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.kite"
        },
        {
          "match": "<<|>>|&|\\||\\^|~",
          "name": "keyword.operator.bitwise.kite"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.kite"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.kite"
        },
        {
          "match": "\\+|-|\\*|/|%",
          "name": "keyword.operator.arithmetic.kite"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.kite"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.kite"
        },
        {
          "match": "[\\[\\](){}]",
          "name": "punctuation.bracket.kite"
        }
      ]
    }
  }
}
