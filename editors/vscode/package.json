{
  "name": "kite-lang",
  "displayName": "Kite",
  "description": "Syntax highlighting, snippets and language configuration for the Kite programming language (.ki)",
  "version": "0.3.0",
  "publisher": "yo-le-zz",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yo-le-zz/vscode-kite"
  },
  "homepage": "https://github.com/yo-le-zz/Kite",
  "bugs": {
    "url": "https://github.com/yo-le-zz/Kite/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "kite",
    "ki",
    "syntax",
    "highlighting",
    "snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kite",
        "aliases": [
          "Kite",
          "kite"
        ],
        "extensions": [
          ".ki"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "kite",
        "scopeName": "source.kite",
        "path": "./syntaxes/kite.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.kite": "kite"
        }
      }
    ],
    "snippets": [
      {
        "language": "kite",
        "path": "./snippets/kite.code-snippets"
      }
    ],
    "configurationDefaults": {
      "[kite]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoIndent": "full",
        "editor.wordBasedSuggestions": "matchingDocuments"
      }
    }
  },
  "scripts": {
    "test": "vscode-tmgrammar-test -g syntaxes/kite.tmLanguage.json \"test/**/*.test.ki\" && vscode-tmgrammar-snap \"test/snap/*.ki\"",
    "snap": "vscode-tmgrammar-snap -u \"test/snap/*.ki\"",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
