// Kite 0.3 feature tour
use math
from util import trim, join

type Point:
    x: int
    tags: [string]
    next: ptr<Point>

enum Shape:
    Circle(r: int)
    Rect(int, int)
    Empty

extern make puts(s: string) -> int

make area(s: Shape, scale: int = 2, *rest: int) -> (int, float):
    match s:
        case Circle(r):
            return (3 * r * r, 1.5)
        case Rect(w, h):
            return (w * h, 2.0)
        else:
            return (0, 0.0)

make main():
    name = "Kite"
    n: int = 0
    n += 1
    n <<= 2
    a, b = area(Shape.Circle(2))
    xs: [int] = []
    p = alloc(Point)
    p.x = ~n & 255 | 1
    q = *p
    if n >= 1 and not done or x != y:
        print(f"hello {name}, {n + 1} {{literal}} \"q\"")
    for i = 0 to 10:
        append(xs, i)
    for x in xs:
        continue
    try:
        risky(n=3)
    failed err:
        print(err)
    finally:
        done = true
    r = null
    obj.method(a, b=2).field[0]
